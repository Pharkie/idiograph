    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "languages": ["English"],
        "customLanguageFiles": {
          "English": "windows/English.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDRUE2QTM1NkVGQjNFNjMKUldSalB2dHVOV3JxUEk2clBDaFg1cUZ4S281VTJaTmE4YjUwMFNZU2tLRzN4aFJITzZ2SlA0YncK",
      "endpoints": ["https://github.com/Pharkie/idiograph/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
