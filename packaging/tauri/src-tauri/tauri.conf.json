{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Idiograph",
  "mainBinaryName": "Idiograph",
  "version": "0.9.26",
  "identifier": "uk.co.adamknowles.idiograph",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Adam Knowles",
    "copyright": "© 2026 Adam Knowles",
    "license": "AGPL-3.0-only",
    "category": "Education",
    "shortDescription": "Idiograph",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../docs/manual.md": "docs/manual.md",
      "../../../docs/whats-new.md": "docs/whats-new.md"
    },
    "fileAssociations": [
      {
        "ext": ["idiograph"],
        "name": "Idiograph.SharedCopy",
        "description": "Idiograph shared copy",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "uk.co.adamknowles.idiograph.shared-copy",
          "conformsTo": ["public.data", "public.content"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
