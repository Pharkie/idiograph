<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath's first request of a release (docs/signing.md): the four programs build_windows.py --stage freeze leaves in
     build/signpath/unsigned, the server's three in server/ and the window in window/. Paste it into the project's
     artifact configuration in SignPath, with the slug the workflow names. The parameters come from the workflow. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="productName" default-value="Idiograph" />
    <parameter name="versionThree" default-value="0.0.0" />
    <parameter name="versionFour" default-value="0.0.0.0" />
  </parameters>
  <zip-file>
    <directory path="server">
      <pe-file path="${productName}.exe" product-name="${productName}" product-version="${versionFour}">
        <authenticode-sign/>
      </pe-file>
      <pe-file path="${productName}-console.exe" product-name="${productName}" product-version="${versionFour}">
        <authenticode-sign/>
      </pe-file>
      <pe-file path="idiograph-typeset.exe">
        <authenticode-sign/>
      </pe-file>
    </directory>
    <directory path="window">
      <pe-file path="${productName}.exe" product-name="${productName}" product-version="${versionThree}">
        <authenticode-sign/>
      </pe-file>
    </directory>
  </zip-file>
</artifact-configuration>
