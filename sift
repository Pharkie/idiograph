#!/bin/sh
# Sift's command line from source, macOS or Linux: the venv's python running cli.py as Sift, from
# wherever it is called, so a relative folder reads from there. The venv is found as the idiograph
# command finds it. Its arguments are the sift command's own, as `idiograph sift` took them:
#   ./sift search strings "<review folder>"
# In the Mac app it is the app's own server with cli first:
#   /Applications/Sift.app/Contents/Resources/server/Sift cli ...
# See docs/agents-sift.md.
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="$HERE/.venv/bin/python3"
[ -x "$PY" ] || PY="$HERE/../../.venv/bin/python3"
[ -x "$PY" ] || PY="python3"
exec "$PY" "$HERE/cli.py" --app sift "$@"
