def check_budgets(view: View) -> tuple[bool, str, str | None]:
    # The gate's own tests take seconds, so they skip here and run in the full gate below.
    if not (view.root / "gate_tests").is_dir():
        return True, "[budgets] gate_tests/ does not exist, skipped", None
    code, out = run([sys.executable, "-m", "unittest", "discover", "-s", "gate_tests"], cwd=view.root,
                    env={"IDIOGRAPH_GATE_TESTS": "0"})
    ok = code == 0
    return ok, out.strip(), None if ok else "budgets"


def check_gate_tests(view: View) -> tuple[bool, str, str | None]:
    if not (view.root / "gate_tests" / "test_gate.py").is_file():
        return True, "[gate] gate_tests/test_gate.py does not exist, skipped", None
    code, out = run([sys.executable, "-m", "unittest", "discover", "-s", "gate_tests", "-p", "test_gate.py"],
                    cwd=view.root, env={"IDIOGRAPH_GATE_TESTS": "1"})
    ok = code == 0
    return ok, f"[gate] the gate's own tests {'pass' if ok else 'failed'}\n{out.strip()}", None if ok else "gate"


def check_pseudonym(view: View) -> tuple[bool, str, str | None]:
    if not PSEUDONYM_RXS:
        return True, f"[pseudonym] no forbidden names in {GATE_LOCAL}, skipped", None
    hits: list[str] = []
    scanned = 0
    for label, text in view_texts(view, view.tracked, exempt=PSEUDONYM_EXEMPT):
        scanned += 1
        if any(rx.search(text) for rx in PSEUDONYM_RXS):
            hits.append(label)
    if hits:
        body = "\n".join(f"  the forbidden name appears in: {h}" for h in hits)
        return False, f"[pseudonym] {len(hits)} hit(s) in {scanned} files\n{body}", "pseudonym"
    return True, f"[pseudonym] clean, {scanned} tracked and staged text files scanned", None


def check_case_folder_names(view: View) -> tuple[bool, str, str | None]:
    """No case-folder suffix may be in git history, or on its way in.

    Scans every tracked file plus everything staged. Untracked files are out of
    scope by design: they are not in history and not entering it, and the
    backlog carries the job of scrubbing the ones that will be committed. A hit
    is reported by path and count, never by quoting the matched text.
    """
    hits: list[str] = []
    scanned = 0
    for label, text in view_texts(view, view.tracked):
        scanned += 1
        found = len(CASE_FOLDER_RX.findall(text))
        if found:
            hits.append(f"  {label}: {found} case-folder reference(s), name the case by pseudonym alone")
    if hits:
        return (
            False,
            f"[case folders] {len(hits)} file(s) in or entering history\n" + "\n".join(hits),
            "case-folder-name",
        )
    return True, f"[case folders] clean, {scanned} tracked and staged text files scanned", None


# Conflict markers (26 October 2026): train 55 passed with a 3-way apply's markers left in
# tests/README.md. A file is refused when it holds all three kinds of marker line, an opener, a
# divider and a closer, each at a line's start, so a Markdown rule of seven equals signs alone never is.
CONFLICT_OPEN_RX = re.compile(r"^<{7}(?: |$)", re.M)
CONFLICT_MID_RX = re.compile(r"^={7}$", re.M)
CONFLICT_CLOSE_RX = re.compile(r"^>{7}(?: |$)", re.M)
# files never read for markers: pictures, sound, archives, fonts, workbooks and other binaries
CONFLICT_SKIP_SUFFIXES = {
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".icns", ".pdf", ".zip", ".gz", ".m4a",
    ".mp3", ".mp4", ".wav", ".mov", ".xlsx", ".docx", ".pptx", ".woff", ".woff2", ".ttf", ".otf",
    ".idiograph", ".dmg", ".exe", ".msi",
}


def conflict_lines(text: str) -> list[int]:
    """The line numbers of a text's conflict markers, or none unless it holds all three kinds."""
    found = [rx.search(text) for rx in (CONFLICT_OPEN_RX, CONFLICT_MID_RX, CONFLICT_CLOSE_RX)]
    if not all(found):
        return []
    hits = set()
    for rx in (CONFLICT_OPEN_RX, CONFLICT_MID_RX, CONFLICT_CLOSE_RX):
        hits |= {text.count("\n", 0, m.start()) + 1 for m in rx.finditer(text)}
    return sorted(hits)


def check_conflict_markers(view: View) -> tuple[bool, str, str | None]:
    """No tracked or staged file may hold the conflict markers a 3-way apply leaves. Every file
    but the binary kinds is read, code, styles and scripts among them."""
    hits: list[str] = []
    scanned = 0
    readable = lambda rel: Path(rel).suffix.lower() not in CONFLICT_SKIP_SUFFIXES
    for label, text in view_texts(view, view.tracked, wanted=readable):
        if "\0" in text:
            continue
        scanned += 1
        lines = conflict_lines(text)
        if lines:
            shown = ", ".join(str(n) for n in lines[:6]) + (" ..." if len(lines) > 6 else "")
            hits.append(f"  {label}: conflict markers at line(s) {shown}")
    if hits:
        return (False, f"[conflict markers] {len(hits)} file(s) hold a 3-way apply's markers\n" + "\n".join(hits),
                "conflict-markers")
    return True, f"[conflict markers] clean, {scanned} tracked and staged files scanned", None


def check_docs_scope(view: View) -> tuple[bool, str, str | None]:
    offenders = [
        p
        for p in view.changed
        if Path(p).suffix.lower() not in DOCS_OK_SUFFIXES
        and not p.startswith(DOCS_OK_PREFIXES)
    ]
    if offenders:
        body = "\n".join(f"  not a docs path: {p}" for p in offenders[:25])
        more = "" if len(offenders) <= 25 else f"\n  ... and {len(offenders) - 25} more"
        return (
            False,
            f"[docs scope] {len(offenders)} non-docs path(s) changed\n{body}{more}",
            "diff-not-docs-only",
        )
    return True, "[docs scope] the diff is docs only", None


def report_banned_patterns(view: View) -> str:
    targets = [
        p
        for p in view.changed
        if CASE_STUDY_DIR and p.startswith(CASE_STUDY_DIR) and p.lower().endswith(".md")
    ]
    if not targets:
        return "[banned patterns] no changed case-study markdown, nothing to report"
    lines = [f"[banned patterns] report only, never a failure, {len(targets)} file(s)"]
    for rel in targets:
        try:
            text = (view.root / rel).read_text(encoding="utf-8", errors="replace")
        except OSError:
            lines.append(f"  {rel}: unreadable")
            continue
        counts = [
            f"{label} x{len(rx.findall(text))}"
            for label, rx in BANNED
            if rx.search(text)
        ]
        lines.append(f"  {rel}: {', '.join(counts) if counts else 'clean'}")
    return "\n".join(lines)


def check_py_compile(view: View) -> tuple[bool, str, str | None]:
    files = [p for p in view.tracked if p.endswith(".py") and ".bak" not in Path(p).name]
    if not files:
        return True, "[py_compile] no tracked .py files, skipped", None
    # Compile into a temp directory. `python -m py_compile` writes .pyc files
    # into a __pycache__ beside each source, and the gate must not write into
    # the tree it checks.
    import py_compile

    errors = []
    with tempfile.TemporaryDirectory(prefix="idiograph-verify-pyc-") as tmp:
        for i, rel in enumerate(files):
            try:
                py_compile.compile(
                    str(view.root / rel),
                    cfile=str(Path(tmp) / f"{i}.pyc"),
                    doraise=True,
                    quiet=2,
                )
            except py_compile.PyCompileError as exc:
                errors.append(f"  {rel}: {exc}")
            except OSError as exc:
                errors.append(f"  {rel}: {exc}")
    if errors:
        body = "\n".join(errors)
        return False, f"[py_compile] {len(errors)} file(s) failed\n{body}", "py-compile"
    return True, f"[py_compile] {len(files)} tracked file(s) compile", None


def check_name_scan(view: View) -> tuple[bool, str, str | None]:
    """The maintainer's real-name scan over the snapshot, so no tracked file carries a real name.
    The script stays in the study folder and reads the register beside its own case data there.
    The script, the data and the register are named only in the local gate file. --include-p2
    because the script leaves out a top-level folder of one case unless asked, and every folder
    of this tree is scanned."""
    if not (NAME_SCAN and MAIN_DATA and REGISTER_NAME):
        return True, f"[name scan] not set up in {GATE_LOCAL}, skipped", None
    script = NAME_SCAN
    register = MAIN_DATA / REGISTER_NAME
    if not script.is_file():
        return True, f"[name scan] script missing at {script}, skipped", None
    if not register.is_file():
        return True, "[name scan] pseudonym register absent (it is never committed), skipped", None
    code, out = run([sys.executable, str(script), "--root", str(view.root), "--include-p2"],
                    cwd=view.root)
    found = 0
    for label in ("[filenames]", "[contents]"):
        match = re.search(re.escape(label) + r"\s+(\d+) hit", out)
        if match:
            found += int(match.group(1))
    if "ERROR" in out and code not in (0, 1):
        return False, f"[name scan] did not run\n{out.strip()}", "name-scan-error"
    summary = (
        f"[name scan] {found} hit(s), baseline {NAME_SCAN_BASELINE}\n"
        + "\n".join(
            "  " + line
            for line in out.splitlines()
            if line.startswith(("[", "  "))
        )
    )
    if found > NAME_SCAN_BASELINE:
        return False, summary, "real-name-leak"
    return True, summary, None


# Participants' words (10 November 2026). Before the repository went public a check was found using
# a participant's own spoken lines as its invented fixture, and another the maintainer's PET title for
# a real participant. So no tracked file may hold eight words running from a participant's turn, a
# statement, a quote or a PET's title of any case the local gate file reaches: `main_data`'s case
# folders and those of each folder in `words_sources` (a list of folders under `academy`), their
# workbooks, CSVs and board files. The runs are kept only as hashes, so neither the cache nor the
# gate's output holds a word. A run found in WORDS_COMMON or more cases is everyday speech and
# dropped. The interviewer's turns are left out, the speaker or speakers the local file's
# `interviewer` names ("Interviewer" with none). A hit names the file and how many runs, never the
# words or the case.
WORDS_RUN = 8
WORDS_COMMON = 3
WORDS_VERSION = 2
WORDS_CACHE_DIR = VERIFY_DIR
WORDS_CACHE_NAME = "participant-words.bin"
WORDS_MEMO_NAME = "participant-words-files.json"
WORD_RX = re.compile(r"[^\W_]+")
WORDS_TABLES = {".xlsx", ".csv"}
# a case's boards, `<stem>.themes.json` and a timepoint's `<stem>.themes-t2.json`, for its PETs' titles
WORDS_BOARDS_RX = re.compile(r"\.themes(-t\d+)?\.json$", re.IGNORECASE)
# the words a board keeps: a label's title and description, a card's statement, a note
WORDS_BOARD_KEYS = {"label", "description", "text"}
# files of the tree read as the zip they are, their text parts' words scanned
WORDS_ZIPS = {".xlsx", ".docx", ".pptx", ".zip", ".idiograph"}
WORDS_ZIP_PARTS = (".xml", ".json", ".csv", ".txt", ".md")
WORDS_CASE_RX = re.compile(r"P\d+\s*-\s*([^\W\d_]+)")
WORDS_ROLES = {
    "name": lambda h: h in ("name", "speaker"),
    "turn": lambda h: h in ("transcript", "text") or h.startswith("transcript"),
    "es": lambda h: "experien" in h and "state" in h,
    "kq": lambda h: "key quote" in h or h in ("quote", "quotes"),
    "ctx": lambda h: h == "other speaker",
    "title": lambda h: h in ("pet", "sub-theme", "lpet", "sub lpet", "get"),
}


def words_of(text: str) -> list[str]:
    """A text's words, lower case, apostrophes dropped, so "don't" and "Don’t" are one word."""
    return WORD_RX.findall(text.replace("'", "").replace("’", "").lower())


def word_runs(words: list[str]):
    """Each run of WORDS_RUN words as a 64-bit hash."""
    hasher = hashlib.blake2b
    for run in zip(*(words[i:] for i in range(WORDS_RUN))):
        yield int.from_bytes(hasher(" ".join(run).encode("utf-8"), digest_size=8).digest(), "big")


def words_roots() -> list[Path]:
    roots = [MAIN_DATA] if MAIN_DATA else []
    extra = LOCAL.get("words_sources")
    if ACADEMY and isinstance(extra, list):
        roots += [ACADEMY / item for item in extra if isinstance(item, str) and item.strip()]
    return [root for root in roots if root.is_dir()]


def words_interviewers() -> set[str]:
    value = LOCAL.get("interviewer")
    names = [value] if isinstance(value, str) else value if isinstance(value, list) else []
    return {n.strip().lower() for n in names if isinstance(n, str) and n.strip()} or {"interviewer"}


def words_case(folder: str) -> str:
    """A case by its pseudonym, from a folder named `P<n> - <Pseudonym>...`, else the folder's name."""
    match = WORDS_CASE_RX.match(folder)
    return (match.group(1) if match else folder).strip().lower()


def words_files(roots: list[Path]) -> list[tuple[str, Path]]:
    """Every workbook, CSV and board file in each root's case folders, a folder starting with _ or .
    left out (an _Archive's older copies)."""
    found: list[tuple[str, Path]] = []
    for root in roots:
        for case_dir in sorted(root.iterdir()):
            if not case_dir.is_dir() or case_dir.name.startswith((".", "_")):
                continue
            case = words_case(case_dir.name)
            for dirpath, dirnames, filenames in os.walk(case_dir):
                dirnames[:] = sorted(d for d in dirnames if not d.startswith((".", "_")))
                for name in sorted(filenames):
                    if name.startswith(("~$", ".")):
                        continue
                    if Path(name).suffix.lower() in WORDS_TABLES or WORDS_BOARDS_RX.search(name):
                        found.append((case, Path(dirpath) / name))
    return found


def words_table(header, rows, interviewers: set[str]):
    """The participant's words of one table: each row's turn unless the interviewer's, its statements,
    its quotes, another speaker's words and a PET's title, the columns found by their headings as the
    app finds them."""
    cols: dict[str, int] = {}
    for i, raw in enumerate(list(header)[:12]):
        heading = str(raw or "").strip().lower()
        for role, test in WORDS_ROLES.items():
            if role not in cols and test(heading):
                cols[role] = i
                break
    said = [role for role in ("turn", "es", "kq", "ctx", "title") if role in cols]
    if not said:
        return
    for row in rows:
        row = list(row)
        cell = lambda role: row[cols[role]] if role in cols and cols[role] < len(row) else None
        who = str(cell("name") or "").strip().lower()
        for role in said:
            if role == "turn" and who in interviewers:
                continue
            value = cell(role)
            if isinstance(value, str) and value.strip():
                yield value


def words_on_board(value):
    """A board file's words: every title, description, statement, note and quote in it."""
    if isinstance(value, dict):
        for key, inner in value.items():
            if key in WORDS_BOARD_KEYS and isinstance(inner, str):
                yield inner
            elif key == "quoted" and isinstance(inner, dict):
                yield from (text for text in inner.values() if isinstance(text, str))
            else:
                yield from words_on_board(inner)
    elif isinstance(value, list):
        for inner in value:
            yield from words_on_board(inner)


def words_in_file(path: Path, interviewers: set[str]):
    """A workbook, CSV or board file's participant words, the workbook opened read-only."""
    if WORDS_BOARDS_RX.search(path.name):
        yield from words_on_board(json.loads(path.read_text(encoding="utf-8")))
        return
    if path.suffix.lower() == ".csv":
        reader = csv.reader(io.StringIO(path.read_text(encoding="utf-8-sig", errors="replace")))
        header = next(reader, None)
        if header:
            yield from words_table(header, reader, interviewers)
        return
    import openpyxl

    book = openpyxl.load_workbook(path, read_only=True, data_only=True)
    try:
        for sheet in book.worksheets:
            rows = sheet.iter_rows(values_only=True)
            header = next(rows, None)
            if header:
                yield from words_table(header, rows, interviewers)
    finally:
        book.close()


def words_key(files: list[tuple[str, Path]], interviewers: set[str]) -> str:
    """The sources as they stand, by each file's size and time, so an unchanged set reads no workbook."""
    digest = hashlib.sha256(json.dumps([WORDS_VERSION, WORDS_RUN, WORDS_COMMON, sorted(interviewers)]).encode())
    for case, path in files:
        info = path.stat()
        digest.update(f"{case}\0{path}\0{info.st_size}\0{info.st_mtime_ns}\n".encode("utf-8", "replace"))
    return digest.hexdigest()


def words_build(files: list[tuple[str, Path]], interviewers: set[str]) -> tuple[set[int], int]:
    """The runs of every case, those in WORDS_COMMON cases or more dropped, and how many files would not read."""
    per_case: dict[str, set[int]] = {}
    unread = 0
    for case, path in files:
        runs = per_case.setdefault(case, set())
        try:
            for text in words_in_file(path, interviewers):
                runs.update(word_runs(words_of(text)))
        except Exception:  # noqa: BLE001  a file iCloud has not brought down, or a broken one
            unread += 1
    seen: collections.Counter = collections.Counter()
    for runs in per_case.values():
        seen.update(runs)
    return {run for run, cases in seen.items() if cases < WORDS_COMMON}, unread


def words_write(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    part = path.with_name(f"{path.name}.{os.getpid()}.part")
    part.write_bytes(data)
    os.replace(part, path)


def words_load(key: str) -> set[int] | None:
    try:
        data = (WORDS_CACHE_DIR / WORDS_CACHE_NAME).read_bytes()
        head, body = data.split(b"\n", 1)
        if json.loads(head).get("key") != key:
            return None
        runs = array("Q")
        runs.frombytes(body)
        return set(runs)
    except (OSError, ValueError):
        return None


def words_known(build: bool) -> tuple[set[int] | None, str, str]:
    """The participants' runs, from the cache when the sources are unchanged, else read when `build`.
    None, with the reason, when there is nothing to read or the cache will not do."""
    roots = words_roots()
    if not roots:
        return None, "", f"no case data reachable from {GATE_LOCAL}, skipped"
    interviewers = words_interviewers()
    files = words_files(roots)
    if not files:
        return None, "", "no workbook or CSV in the case folders, skipped"
    cases = len({case for case, _ in files})
    key = words_key(files, interviewers)
    known = words_load(key)
    if known is not None:
        return known, key, f"{len(known)} runs from {len(files)} files of {cases} cases, cached"
    if not build:
        return None, key, "the sources changed since the cache was made, the full gate reads them, skipped"
    try:
        import openpyxl  # noqa: F401
    except ImportError:
        return None, key, "openpyxl is missing, skipped"
    known, unread = words_build(files, interviewers)
    if unread:
        said = f"{unread} of {len(files)} files would not read, so nothing is cached"
    else:
        runs = array("Q", sorted(known))
        words_write(WORDS_CACHE_DIR / WORDS_CACHE_NAME, json.dumps({"key": key}).encode() + b"\n" + runs.tobytes())
        said = "cached"
    return known, key, f"{len(known)} runs read from {len(files)} files of {cases} cases, {said}"


def zip_text(path: Path) -> str:
    """The text parts of a workbook, a Word file or another zip of the tree, their markup set aside."""
    try:
        with zipfile.ZipFile(path) as archive:
            parts = [archive.read(name).decode("utf-8", errors="replace") for name in archive.namelist()
                     if name.lower().endswith(WORDS_ZIP_PARTS)]
    except (OSError, zipfile.BadZipFile, RuntimeError):
        return ""
    return re.sub(r"<[^>]+>", " ", "\n".join(parts))


def words_tree(view: View):
    """Every tracked and staged file of the snapshot as text, JSON, code and scripts among them, and the
    tree's workbooks and Word files by their text parts. Pictures, fonts and other binaries are passed over."""
    readable = lambda rel: Path(rel).suffix.lower() not in CONFLICT_SKIP_SUFFIXES
    for label, text in view_texts(view, view.tracked, wanted=readable):
        if "\0" not in text:
            yield label, text
    for rel in view.tracked:
        if Path(rel).suffix.lower() in WORDS_ZIPS and (view.root / rel).is_file():
            text = zip_text(view.root / rel)
            if text:
                yield rel, text


def check_participant_words(view: View, build: bool = True) -> tuple[bool, str, str | None]:
    """No tracked file holds eight words running from a participant's words (the note above). Each file's
    count is remembered by its content, so an unchanged file is not read for runs again."""
    known, key, said = words_known(build)
    if known is None:
        return True, f"[participant words] {said}", None
    memo_path = WORDS_CACHE_DIR / WORDS_MEMO_NAME
    try:
        memo = json.loads(memo_path.read_text(encoding="utf-8"))
        memo = memo.get("files", {}) if memo.get("key") == key else {}
    except (OSError, ValueError, AttributeError):
        memo = {}
    fresh: dict[str, int] = {}
    hits: list[str] = []
    scanned = 0
    for label, text in words_tree(view):
        scanned += 1
        sha = hashlib.sha1(text.encode("utf-8", "replace")).hexdigest()
        found = memo.get(sha)
        if not isinstance(found, int):
            found = len(known.intersection(word_runs(words_of(text))))
        fresh[sha] = found
        if found:
            hits.append(f"  {label}: {found} run(s) of eight words from a participant's words")
    try:
        words_write(memo_path, json.dumps({"key": key, "files": fresh}).encode("utf-8"))
    except OSError:
        pass
    if hits:
        return (False, f"[participant words] {len(hits)} file(s) hold a participant's words, "
                       f"{said}\n" + "\n".join(hits), "participant-words")
    return True, f"[participant words] clean, {scanned} tracked and staged files scanned, {said}", None


def check_participant_words_cached(view: View) -> tuple[bool, str, str | None]:
    """The fast gate's and ./commit's scan: the cache's runs alone, never a workbook read."""
    return check_participant_words(view, build=False)


def check_idiograph(view: View) -> tuple[bool, str, str | None]:
    """The snapshot's suite, its reference checks pointed at the real case data, and the
    real participant data linked in for the check that reads participants' words. The
    full suite runs in the coordinator's train alone (Adam, 18 October), and this run is
    one, so IDIOGRAPH_TRAIN=1 tells the suite so. Outside a train it skips itself."""
    tests = view.root / "tests"
    if not tests.is_dir():
        return True, "[idiograph] tests does not exist yet, skipped", None
    # No -t: the start directory is its own top level, so a plain tests folder
    # with no __init__.py stays importable. Passing the parent broke this once.
    # the suite reads the same local gate file, and the real data's folders when there are any
    env = {"IDIOGRAPH_GATE_LOCAL": str(GATE_LOCAL), IDIOGRAPH_TRAIN: "1"}
    if MAIN_DATA:
        env["IDIOGRAPH_MAIN_DATA"] = str(MAIN_DATA)
    if ACADEMY:
        env["IDIOGRAPH_ACADEMY"] = str(ACADEMY)
    code, out = run([sys.executable, "-m", "unittest", "discover", "-s", str(tests)],
                    cwd=view.root, env=env)
    # The empty-suite branch comes first: unittest exits 5, not 0, when it
    # collects nothing, and an empty suite is a gap to report, not a failure.
    if "NO TESTS RAN" in out or "Ran 0 tests" in out:
        # As of 21 September 2026 the Idiograph suite is a standalone script with
        # its own runner, not unittest TestCases, so discovery collects nothing.
        # Say so rather than reporting a pass nobody earned. Fix: expose TestCases
        # there, or teach this check that tool's own entry point.
        return True, "[idiograph] discovery collected 0 tests, so nothing was checked here", None
    if code != 0:
        return False, f"[idiograph] suite failed\n{out.strip()}", "idiograph"
    # The suite prints its count line when it has run. A skip without one means it took
    # this run for one outside a train, so nothing was checked, and that is no pass.
    if "skipped=" in out and not SUITE_COUNT_RX.search(out):
        return False, f"[idiograph] the suite skipped itself, so nothing was checked\n{out.strip()}", \
            "idiograph-not-run"
    return True, f"[idiograph] suite passes\n{out.strip()}", None


FAST_CHECKS = [
    ("budgets", check_budgets),
    ("pseudonym", check_pseudonym),
    ("case folders", check_case_folder_names),
    ("conflict markers", check_conflict_markers),
    ("participant words", check_participant_words_cached),
]


def run_checks(checks, view: View) -> tuple[bool, str | None]:
    ok, reason = True, None
    for name, fn in checks:
        passed, output, why = fn(view)
        print(output or f"[{name}] no output", flush=True)
        if not passed and ok:
            ok, reason = False, why
    return ok, reason


# ---------------------------------------------------------------- the gate


def verdict(ok: bool, mode: str, sha: str, tree: str, reason: str | None,
            snap: str | None = None) -> str:
    line = (
        f"VERIFY: {'GREEN' if ok else 'RED'} "
        f"merge={'yes' if ok else 'no'} mode={mode} sha={sha} tree={tree}"
    )
    if not ok and reason:
        line += f" reason={reason}"
    if snap:
        line += f" snap={snap}"
    return line


def emit(line: str) -> None:
    VERIFY_DIR.mkdir(exist_ok=True)
    stamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
    with HISTORY.open("a", encoding="utf-8") as fh:
        fh.write(f"{stamp} {line}\n")
    print(line, flush=True)


def gate(mode: str) -> int:
    """A full run waits its turn on the shared Mac before any lock, so a waiting run blocks no
    other run or commit. The waiter or announcement goes however the run ends."""
    place = MachinePlace() if mode == "full" else None
    try:
        if place:
            place.wait()
        return gate_run(mode, place)
    finally:
        if place:
            place.release()


def gate_run(mode: str, place: MachinePlace | None) -> int:
    """Lock, snapshot, check, clean up, and only then the verdict, so it is the last line."""
    run_lock = Lock(RUN_LOCK)
    if not run_lock.acquire():
        if place:
            place.release()
        print(f"[lock] a run holds {RUN_LOCK}, PID {run_lock.holder()}")
        emit(verdict(False, mode, head_sha(), tree_state(), "locked"))
        return 1
    base = TMP / f"{SNAP_PREFIX}{os.getpid()}"
    held: list[View] = []
    try:
        if place:
            place.announce()
        line = gate_locked(mode, base, held)
    finally:
        if not remove_tree(base, held[0].links if held else None):
            print(f"[snapshot] could not remove {base}")
        if place:
            place.release()
        run_lock.release()
    emit(line)
    return 0 if line.startswith("VERIFY: GREEN") else 1


def gate_locked(mode: str, base: Path, held: list[View]) -> str:
    """The run under the run lock. The commit lock is held only while the snapshot is taken."""
    started = time.time()
    sweep_stale_work()
    commit_lock = Lock(COMMIT_LOCK)
    if not commit_lock.wait(COMMIT_WAIT, "a commit, or a run taking its snapshot"):
        print(f"[lock] gave up on {COMMIT_LOCK}, PID {commit_lock.holder()} holds it")
        return verdict(False, mode, head_sha(), tree_state(), "locked")
    locked_at = time.time()
    try:
        swept = sweep_icloud_copies()
        remove_tree(base)
        view, notes = take_snapshot(base)
        held.append(view)
    except (OSError, SnapshotError, ValueError) as exc:
        print(f"[snapshot] failed: {exc}")
        return verdict(False, mode, head_sha(), tree_state(), "snapshot-failed")
    finally:
        commit_lock.release()

    print(f"[verify] mode={mode} sha={view.head} tree={view.tree} snap={view.snap}")
    for line in swept + notes:
        print(line)
    print(f"[lock] commit lock released after {time.time() - locked_at:.1f}s, "
          "the checks below read the snapshot", flush=True)

    checks = list(FAST_CHECKS)
    if mode == "full":
        # the full gate reads the sources when they changed, where the fast one only takes the cache
        checks = [(name, check_participant_words if fn is check_participant_words_cached else fn)
                  for name, fn in checks]
    if mode == "docs":
        checks.append(("docs scope", check_docs_scope))
    if mode == "full":
        checks += [
            ("py_compile", check_py_compile),
            ("gate", check_gate_tests),
            ("name scan", check_name_scan),
            ("idiograph", check_idiograph),
        ]
    ok, reason = run_checks(checks, view)
    if mode in ("docs", "full"):
        print(report_banned_patterns(view))
    print(f"[verify] {time.time() - started:.1f}s", flush=True)
    return verdict(ok, mode, view.head, view.tree, reason, view.snap)


# ---------------------------------------------------------------- ./commit


COMMIT_USAGE = './commit -m "<message>" -- <path>...'


def commit_verdict(ok: bool, sha: str | None = None, reason: str | None = None) -> int:
    emit(f"COMMIT: GREEN sha={sha}" if ok else f"COMMIT: RED reason={reason}")
    return 0 if ok else 1


def parse_commit_args(argv: list[str]) -> tuple[list[str], list[str], str | None]:
    messages: list[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            break
        if arg in ("-m", "--message"):
            if i + 1 >= len(argv):
                return [], [], f"{arg} needs a message"
            messages.append(argv[i + 1])
            i += 2
        elif arg.startswith("--message="):
            messages.append(arg.split("=", 1)[1])
            i += 1
        elif arg.startswith("-m") and len(arg) > 2:
            messages.append(arg[2:])
            i += 1
        else:
            return [], [], f"unknown argument {arg!r}, the paths go after --"
    paths = argv[i + 1:]
    if not any(m.strip() for m in messages):
        return [], [], "a message is needed"
    if not paths:
        return [], [], "name the paths to commit after --"
    rels = []
    root = os.path.realpath(ROOT)
    for p in paths:
        full = os.path.abspath(p)
        full = os.path.join(os.path.realpath(os.path.dirname(full)), os.path.basename(full))
        rel = os.path.relpath(full, root)
        if rel == ".." or rel.startswith("../"):
            return [], [], f"{p} is outside the repo"
        rels.append(rel)
    return messages, rels, None


def ls_tree(tree: str, paths: list[str]) -> dict[str, str] | None:
    code, out, _ = git_run("ls-tree", "-r", "-z", "--full-tree", tree, "--", *paths,
                           env={"GIT_LITERAL_PATHSPECS": "1"})
    if code != 0:
        return None
    held = {}
    for rec in out.decode("utf-8", "surrogateescape").split("\0"):
        if rec:
            info, _, path = rec.partition("\t")
            held[path] = info.split()[2]
    return held


def green_snap_for(code: dict[str, str | None]) -> tuple[bool, str]:
    """Find a GREEN full verdict whose snap holds every code path as it is about to be committed."""
    try:
        lines = HISTORY.read_text(encoding="utf-8").splitlines()
    except OSError:
        lines = []
    snaps: list[tuple[str, str]] = []
    for line in reversed(lines):
        match = GREEN_FULL_RX.search(line)
        if match and match.group(1) not in {s for s, _ in snaps}:
            snaps.append((match.group(1), line.split(" ", 1)[0]))
    paths = sorted(code)
    if not snaps:
        return False, ("[commit] code needs a GREEN full gate first, and no GREEN full verdict "
                       f"with a snap is in .verify/history.log: {', '.join(paths)}")
    latest: list[str] | None = None
    for snap, stamp in snaps[:100]:
        held = ls_tree(snap, paths)
        if held is None:
            continue
        differ = [p for p in paths if held.get(p) != code[p]]
        if not differ:
            return True, f"[commit] the full gate passed this code: snap {snap[:12]} at {stamp}"
        if latest is None:
            latest = differ
    return False, ("[commit] no GREEN full snap holds the present content of: "
                   f"{', '.join(latest or paths)} (run the full gate, then commit)")


def commit_main(argv: list[str]) -> int:
    messages, paths, problem = parse_commit_args(argv)
    if problem:
        print(f"[commit] {problem}. Usage: {COMMIT_USAGE}")
        return commit_verdict(False, reason="usage")
    lock = Lock(COMMIT_LOCK)
    if not lock.wait(COMMIT_WAIT, "a run taking its snapshot, or another commit"):
        print(f"[lock] gave up on {COMMIT_LOCK} after {COMMIT_WAIT:.0f}s, PID {lock.holder()} holds it")
        return commit_verdict(False, reason="locked")
    work = TMP / f"{COMMIT_PREFIX}{os.getpid()}"
    try:
        sweep_stale_work()
        remove_tree(work)
        work.mkdir(mode=0o700)
        return commit_locked(messages, paths, work)
    finally:
        remove_tree(work)
        lock.release()


def commit_locked(messages: list[str], paths: list[str], work: Path) -> int:
    env = {"GIT_INDEX_FILE": str(work / "index"), "GIT_LITERAL_PATHSPECS": "1"}
    old = git("rev-parse", "--verify", "-q", "HEAD").strip()
    code, _, err = git_run("read-tree", old, env=env)
    if code != 0:
        print(f"[commit] could not read HEAD: {err.strip()}")
        return commit_verdict(False, reason="commit-failed")
    # HEAD plus the named paths as they stand: git commit --only, built where it can be checked. A
    # named file HEAD holds and the real index no longer does, after `git rm --cached`, goes as
    # removed with its file left on disk, since add alone puts back a file it finds there.
    held = set(git_z("ls-files", "-z", "--", *paths, env=env))
    gone = sorted(held - set(git_z("ls-files", "-z", "--", *paths, env={"GIT_LITERAL_PATHSPECS": "1"})))
    rest = [p for p in paths if p not in gone]
    code, err = 0, ""
    if rest:
        code, _, err = git_run("add", "-A", "--", *rest, env=env)
    if code == 0 and gone:
        code, _, err = git_run("rm", "-q", "--cached", "--", *gone, env=env)
    if code != 0:
        print(f"[commit] git would not take those paths: {err.strip()}")
        return commit_verdict(False, reason="bad-path")
    changed = git_z("diff-index", "-z", "--cached", "--name-only", old, env=env)
    if not changed:
        print("[commit] the named paths match HEAD, so there is nothing to commit")
        return commit_verdict(False, reason="nothing-to-commit")
    print(f"[commit] {len(changed)} path(s): {', '.join(changed)}")

    # The fast checks, on the tree as it will stand: its text files and tests, from the index.
    entries = index_entries(env)
    tree_dir = work / "tree"
    tree_dir.mkdir()
    wanted = [p for p in entries if is_text(p) or p.startswith("tests/")]
    code, _, err = git_run("checkout-index", "-z", "--stdin", f"--prefix={tree_dir}/", env=env,
                           stdin="\0".join(wanted).encode("utf-8", "surrogateescape"))
    if code != 0:
        print(f"[commit] could not lay out the tree to check: {err.strip()}")
        return commit_verdict(False, reason="commit-failed")
    view = View(root=tree_dir, tracked=list(entries), staged={}, changed=changed)
    ok, reason = run_checks(FAST_CHECKS, view)
    if not ok:
        return commit_verdict(False, reason=reason)

    code_paths = {p: entries.get(p, (None, None))[1] for p in changed if is_code(p)}
    if code_paths:
        gated, line = green_snap_for(code_paths)
        print(line)
        if not gated:
            return commit_verdict(False, reason="code-not-gated")

    code, out, err = git_run("write-tree", env=env)
    tree = out.decode().strip()
    message = git_run("stripspace", stdin="\n\n".join(messages).encode())[1]
    code2, out2, err2 = git_run("commit-tree", tree, "-p", old, "-F", "-", stdin=message)
    new = out2.decode().strip()
    if code != 0 or code2 != 0 or not new:
        print(f"[commit] git could not write the commit: {(err + err2).strip()}")
        return commit_verdict(False, reason="commit-failed")
    subject = message.decode("utf-8", "replace").splitlines()[0] if message.strip() else ""
    code, _, err = git_run("update-ref", "-m", f"commit: {subject}", "HEAD", new, old)
    if code != 0:
        print(f"[commit] HEAD moved while this commit was checked, so nothing was committed: {err.strip()}")
        return commit_verdict(False, reason="head-moved")

    # The real index takes the committed paths, as git commit --only leaves it. Nothing else in it moves.
    for attempt in range(20):
        code, _, err = git_run("reset", "-q", new, "--", *changed, env={"GIT_LITERAL_PATHSPECS": "1"})
        if code == 0:
            break
        time.sleep(0.25)
    else:
        print(f"[commit] the commit landed, but the index still holds the old content of the "
              f"committed paths: run git reset -q -- <those paths>. git said: {err.strip()}")
    return commit_verdict(True, sha=git("rev-parse", "--short", new).strip())


# ---------------------------------------------------------------- driver


def main() -> int:
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)
    argv = sys.argv[1:]
    if argv[:1] == ["--commit"]:
        return commit_main(argv[1:])
    args = set(argv)
    if args & {"-h", "--help"}:
        print(__doc__)
        return 0
    mode = "fast" if "--fast" in args else "docs" if "--docs" in args else "full"
    return gate(mode)


if __name__ == "__main__":
    sys.exit(main())
