def ancestor_pids() -> set[int]:
    """This process's parent, its parent's parent and so on, from one ps call."""
    parents: dict[int, int] = {}
    try:
        out = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True,
                             timeout=10).stdout
        for line in out.splitlines():
            pid, _, ppid = line.strip().partition(" ")
            if pid.isdigit() and ppid.strip().isdigit():
                parents[int(pid)] = int(ppid.strip())
    except (OSError, subprocess.SubprocessError):
        pass
    found: set[int] = set()
    pid = os.getppid()
    while pid > 1 and pid not in found:
        found.add(pid)
        pid = parents.get(pid, 0)
    return found


def machine_entries(folder: Path) -> list[tuple[Path, dict]]:
    entries = []
    for path in sorted(folder.glob("*.json")):
        try:
            entry = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(entry, dict):
            entries.append((path, entry))
    return entries


def written_ms(entry: dict, path: Path) -> float:
    """A file's own time, as heavy takes it: its enqueuedAt, else its startedAt, else its mtime."""
    try:
        if "enqueuedAt" in entry:
            return float(entry["enqueuedAt"])
        if "startedAt" in entry:
            stamp = str(entry["startedAt"]).replace("Z", "+00:00")
            return datetime.fromisoformat(stamp).timestamp() * 1000
    except (TypeError, ValueError, OverflowError, OSError):
        pass
    try:
        return path.stat().st_mtime * 1000
    except OSError:
        return time.time() * 1000


def queued_ms(entry: dict, path: Path) -> float:
    """When a waiter queued, as heavy takes it: its enqueuedAt, else the leading milliseconds of
    its id (Harbour's queue names its entries <ms>-<pid>), else the file's own time."""
    try:
        return float(entry["enqueuedAt"])
    except (KeyError, TypeError, ValueError, OverflowError):
        pass
    try:
        return float(str(entry.get("id", "")).split("-")[0])
    except (TypeError, ValueError, OverflowError):
        return written_ms(entry, path)


def process_began_ms(pid: int) -> float | None:
    """When a process started, from ps in whole seconds, or None when ps cannot say."""
    try:
        out = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True,
                             text=True, timeout=10, env={**os.environ, "LC_ALL": "C"}).stdout
        return datetime.strptime(out.strip(), "%a %b %d %H:%M:%S %Y").timestamp() * 1000
    except (OSError, ValueError, OverflowError, subprocess.SubprocessError):
        return None


def entry_alive(entry: dict, path: Path) -> bool:
    """heavy's rule: a file counts only while its pid lives (a permission error is another
    user's live process) and that process started no later than a minute after the file's own
    time, so a reused pid is dead. A process ps cannot date counts as alive."""
    try:
        pid = int(entry.get("pid", 0))
        if pid <= 0 or not pid_alive(pid):
            return False
    except (TypeError, ValueError, OverflowError, OSError):
        return False
    began = process_began_ms(pid)
    return began is None or began <= written_ms(entry, path) + PID_GRACE_MS


def entry_places(entry: dict) -> int:
    """The places a run takes: its "places" (Harbour's full gate takes both, 2), 1 when absent."""
    try:
        return max(1, int(entry.get("places", 1)))
    except (TypeError, ValueError):
        return 1


def write_json(path: Path, record: dict) -> None:
    """Written whole under a name no reader globs, then renamed into place."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(json.dumps(record) + "\n", encoding="utf-8")
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


class MachinePlace:
    """A full run's heavy place on the shared Mac: a waiter file while it waits, an announcement
    while it runs, and release() removes both however the run ends."""

    def __init__(self) -> None:
        self.folder: Path | None = None
        self.queues: list[Path] = []
        self.waiter: Path | None = None
        self.announced: Path | None = None
        self.inside: Path | None = None  # the announcement of a run this one was started inside
        self.enqueued: int | None = None  # this run's place in the queue, its waiter's enqueuedAt
        self.why_not = ""
        self.how = "no wait"
        self.name = f"{MACHINE_PROJECT}-{os.getpid()}.json"
        self.record = {"project": MACHINE_PROJECT, "pid": os.getpid(), "kind": MACHINE_KIND,
                       "cwd": str(ROOT), "places": MACHINE_RUN_PLACES}
        override = os.environ.get("IDIOGRAPH_MACHINE_LOAD", "").strip()
        if override:
            self.folder = Path(override) if Path(override).is_dir() else None
            self.queues = queues_for_tests()
            self.why_not = f"IDIOGRAPH_MACHINE_LOAD names no folder ({override})"
        elif os.environ.get("IDIOGRAPH_VERIFY_TMP", "").strip():
            self.why_not = "a test run (IDIOGRAPH_VERIFY_TMP set, no IDIOGRAPH_MACHINE_LOAD)"
        elif HEAVY.is_file() or MACHINE_HOME.is_dir():
            self.folder, self.queues = MACHINE_HOME, heavy_queues()
        else:
            self.why_not = "no ~/.claude/bin/heavy or ~/.claude/machine-load on this machine"
        self.cap = env_seconds("IDIOGRAPH_MACHINE_CAP", MACHINE_CAP)
        # The tests' 20 minutes: a waiter counts only while its process started no later than a
        # minute after it queued, so a test cannot write one that has waited 20 minutes.
        self.old_ms = env_seconds("IDIOGRAPH_MACHINE_OLD", OLD_WAITER) * 1000

    def busy(self) -> str | None:
        """Why a full run waits now, by heavy's rule. First, a Harbour gate at the head of
        Harbour's queue: the run waits with no time limit (Adam, 17 October). Harbour's queue is
        not first come, first served, so Harbour marks its head "queueHead": true in waiting/,
        rewritten every poll. Once any live Harbour waiter carries the field, the flag alone
        decides. Until then the head is Harbour's earliest live waiter in waiting/ or its own
        queue folder (an entry there with no project is Harbour's). Then another project's waiter that queued before it and has waited over 20 minutes, or too
        few of the machine's two heavy places free for its own one, each live run counting its
        places. Yielding only to an earlier waiter keeps two fleets' waiters from each waiting on
        the other (17 October). A file counts only while entry_alive() says its run lives."""
        now = time.time() * 1000
        mine = now if self.enqueued is None else self.enqueued
        heads: dict[str, tuple[float, str]] = {}
        aged = False
        flagged = False  # a live Harbour waiter carries "queueHead", so the flag alone decides
        marked: list[dict] = []  # the live Harbour waiters marked "queueHead": true
        folders = [(self.folder / "waiting", False)] + [(q, True) for q in self.queues]
        for folder, harbour_queue in folders:
            for path, entry in machine_entries(folder):
                project = str(entry.get("project") or (GATE_PROJECT if harbour_queue else ""))
                if project in MACHINE_OWN or not entry_alive(entry, path):
                    continue
                if project == GATE_PROJECT and "queueHead" in entry:
                    flagged = True
                    if entry.get("queueHead") is True:
                        marked.append(entry)
                theirs = queued_ms(entry, path)
                if project not in heads or theirs < heads[project][0]:
                    heads[project] = (theirs, str(entry.get("kind", "")))
                if theirs < mine and now - theirs > self.old_ms:
                    aged = True
        if flagged:
            if any(entry.get("kind") == GATE_KIND for entry in marked):
                return GATE_HEADS
        elif heads.get(GATE_PROJECT, (0.0, ""))[1] == GATE_KIND:
            return GATE_HEADS
        if aged:
            return "another project's queue"
        held = sum(entry_places(e) for p, e in machine_entries(self.folder) if entry_alive(e, p))
        if held + MACHINE_RUN_PLACES > MACHINE_PLACES:
            return "two heavy places held"
        return None

    def started_inside(self) -> Path | None:
        """The live announcement of a run this one was started inside, such as heavy's own when
        heavy runs ./verify. That run already holds this one's place, waited for by the same rule,
        and has started, so it finishes whatever heads a queue now."""
        ancestors = ancestor_pids()
        for path, entry in machine_entries(self.folder):
            try:
                pid = int(entry.get("pid", 0))
            except (TypeError, ValueError, OverflowError):
                continue
            if pid in ancestors and entry_alive(entry, path):
                return path
        return None

    def wait(self) -> None:
        """Wait by the rule, as a waiter, before the run lock: with no time limit while a Harbour
        gate heads Harbour's queue, otherwise at most the cap. The waiter file stands until
        announce() or release(), so the run stays in the queue until it holds the lock."""
        if self.folder is None:
            print(f"[machine] {self.why_not}, so this run neither waits nor is announced", flush=True)
            return
        self.inside = self.started_inside()
        if self.inside is not None:
            print(f"[machine] started inside the run announced in {self.inside}, so this run "
                  "neither waits nor is announced again", flush=True)
            return
        if os.environ.get("HEAVY_NO_WAIT", "") == "1":
            self.how = "HEAVY_NO_WAIT=1, no wait"
            return
        start = time.time()
        self.enqueued = int(start * 1000)
        why = self.busy()
        if not why:
            return
        self.waiter = self.folder / "waiting" / self.name
        try:
            write_json(self.waiter, {**self.record, "enqueuedAt": self.enqueued})
        except OSError as exc:
            self.give_up(exc)
            return
        self.say_waiting(why)
        poll = min(15.0, max(0.2, self.cap / 20))
        while why and (why == GATE_HEADS or time.time() - start < self.cap):
            left = self.cap - (time.time() - start)
            time.sleep(poll if why == GATE_HEADS else max(0.0, min(poll, left)))
            was, why = why, self.busy()
            if why and why != was:
                self.say_waiting(why)
        self.how = (f"waited {span(time.time() - start)}" if not why
                    else f"waited the cap of {span(self.cap)}, running anyway")

    @staticmethod
    def say_waiting(why: str) -> None:
        limit = ", with no time limit" if why == GATE_HEADS else ""
        print(f"[machine] waiting: {why}{limit}, since {datetime.now():%H:%M}", flush=True)

    def announce(self) -> None:
        """Holding the run lock: leave the queue and announce the run, in one line. A run started
        inside another's announced run is not announced again."""
        if self.folder is None or self.inside is not None:
            return
        try:
            if self.waiter is not None:
                self.waiter.unlink(missing_ok=True)
                self.waiter = None
            self.announced = self.folder / self.name
            started = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            write_json(self.announced, {**self.record, "startedAt": started})
        except OSError as exc:
            self.give_up(exc)
            return
        print(f"[machine] {self.how}, announced in {self.announced}", flush=True)

    def give_up(self, exc: OSError) -> None:
        print(f"[machine] could not write to {self.folder} ({exc}), so this run goes unannounced",
              flush=True)
        self.release()
        self.folder = None

    def release(self) -> None:
        for path in (self.waiter, self.announced):
            if path is not None:
                try:
                    path.unlink(missing_ok=True)
                except OSError as exc:
                    print(f"[machine] could not remove {path}: {exc}")
        self.waiter = self.announced = None


# ---------------------------------------------------------------- the snapshot


@dataclass
class View:
    """What the checks read: files under `root`, and the index as it stood at the freeze."""

    root: Path
    tracked: list[str]
    staged: dict[str, str | None]  # path to its blob in the index, None when staged for deletion
    changed: list[str]  # paths that differ from HEAD
    head: str = "unknown"
    tree: str = "dirty"
    snap: str | None = None
    links: list[Path] = field(default_factory=list)

    def link(self, rel: str, target: Path) -> None:
        """Point a gitignored path of the snapshot at the real one, for a check that reads it."""
        dest = self.root / rel
        if os.path.lexists(dest) or not target.exists():
            return
        dest.parent.mkdir(parents=True, exist_ok=True)
        os.symlink(target, dest)
        self.links.append(dest)


class SnapshotError(Exception):
    pass


_LIBC = None


def clonefile(src: Path, dst: Path) -> bool:
    """APFS clonefile(2), never following a link: shares the blocks, copies no bytes."""
    global _LIBC
    if _LIBC is None:
        try:
            _LIBC = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
            _LIBC.clonefile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint32]
            _LIBC.clonefile.restype = ctypes.c_int
        except (OSError, AttributeError):
            _LIBC = False
    if not _LIBC:
        return False
    return _LIBC.clonefile(os.fsencode(src), os.fsencode(dst), 1) == 0  # 1 is CLONE_NOFOLLOW


def index_entries(env: dict[str, str]) -> dict[str, tuple[str, str]]:
    entries: dict[str, tuple[str, str]] = {}
    for rec in git_z("ls-files", "-z", "-s", env=env):
        info, _, path = rec.partition("\t")
        mode, sha, _stage = info.split()
        entries[path] = (mode, sha)
    return entries


def take_snapshot(base: Path) -> tuple[View, list[str]]:
    """Clone the tree into base/tree, freeze the index into base/meta, hash the copy into a tree.

    Runs under the commit lock, which is why it does nothing slow it can avoid.
    """
    files, meta = base / "tree", base / "meta"
    base.parent.mkdir(parents=True, exist_ok=True)
    base.mkdir(mode=0o700)  # private: the clones are Adam's files, and the folder is in /tmp
    files.mkdir()
    meta.mkdir()
    notes: list[str] = []

    real_index = Path(git("rev-parse", "--git-path", "index").strip())
    if not real_index.is_absolute():
        real_index = ROOT / real_index
    frozen = meta / "index"
    if real_index.is_file():
        shutil.copy2(real_index, frozen)
    env = {"GIT_INDEX_FILE": str(frozen)}

    head = head_sha()
    tree = tree_state(env)
    entries = index_entries(env)
    tracked = list(entries)
    untracked = [p for p in git_z("ls-files", "-z", "--others", "--exclude-standard", env=env)
                 if not icloud_original(p)]
    staged = {p: entries.get(p, (None, None))[1]
              for p in git_z("diff-index", "-z", "--cached", "--name-only", "HEAD", env=env)}

    cloned = copied = 0
    unsnapped: list[str] = []
    for rel in sorted(set(tracked) | set(untracked)):
        src = ROOT / rel
        try:
            info = os.lstat(src)
        except OSError:
            continue  # deleted in the tree, so absent from the snapshot too
        if stat.S_ISDIR(info.st_mode):
            continue  # a nested repository, which git lists and never descends into
        dst = files / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        if clonefile(src, dst):
            cloned += 1
            continue
        try:
            if stat.S_ISLNK(info.st_mode):
                os.symlink(os.readlink(src), dst)
            elif checks_read(rel):
                shutil.copy2(src, dst)
            else:
                unsnapped.append(rel)
                continue
            copied += 1
        except OSError as exc:
            notes.append(f"[snapshot] could not copy {rel}: {exc}")
            unsnapped.append(rel)

    # The tree object: the frozen index, brought up to the snapshot's content.
    work = meta / "snap-index"
    if frozen.is_file():
        shutil.copy2(frozen, work)
    wenv = {"GIT_INDEX_FILE": str(work)}
    code, _, err = git_run(*SNAP_GIT_CONFIG, f"--work-tree={files}", "add", "-A", env=wenv)
    if code != 0:
        raise SnapshotError(f"git add over the snapshot failed: {err.strip()}")
    for rel in unsnapped:
        # Not in the snapshot, so no check reads it, but the tree must still hold it.
        src = ROOT / rel
        mode = "100755" if os.access(src, os.X_OK) else "100644"
        sha = git("hash-object", "-w", "--", str(src)).strip()
        if not sha and rel in entries:
            mode, sha = entries[rel]
            notes.append(f"[snapshot] {rel} is unreadable, so the snap holds it as the index does")
        if sha:
            git_run("update-index", "--add", "--cacheinfo", f"{mode},{sha},{rel}", env=wenv)
    code, out, err = git_run("write-tree", env=wenv)
    snap = out.decode().strip()
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", snap):
        raise SnapshotError(f"git write-tree failed: {err.strip()}")
    changed = git_z("diff-tree", "-r", "-z", "--no-renames", "--name-only", "HEAD", snap)

    notes.insert(0, f"[snapshot] {cloned} file(s) cloned, {copied} copied, "
                    f"{len(unsnapped)} hashed in place, into {base}")
    view = View(root=files, tracked=tracked, staged=staged, changed=changed,
                head=head, tree=tree, snap=snap)
    return view, notes


def cat_blobs(shas: list[str]) -> dict[str, bytes]:
    """Blob contents from the object store, which never changes under a reader."""
    if not shas:
        return {}
    code, out, _ = git_run("cat-file", "--batch", stdin=("\n".join(shas) + "\n").encode())
    blobs: dict[str, bytes] = {}
    pos = 0
    while pos < len(out):
        end = out.index(b"\n", pos)
        header = out[pos:end].decode().split()
        pos = end + 1
        if len(header) == 3:
            size = int(header[2])
            blobs[header[0]] = out[pos:pos + size]
            pos += size + 1
    return blobs


def view_texts(view: View, paths: list[str], exempt: set[str] = frozenset(), wanted=None):
    """Text files of the view as (label, text): from its files, then any staged
    content that differs from them, read from the frozen index. `wanted` says which
    paths to read, the text kinds (`is_text`) by default."""
    wanted_fn = wanted or is_text
    on_disk: dict[str, str] = {}
    for rel in paths:
        if rel in exempt or not wanted_fn(rel):
            continue
        try:
            on_disk[rel] = (view.root / rel).read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        yield rel, on_disk[rel]
    wanted = {rel: sha for rel, sha in view.staged.items()
              if sha and rel not in exempt and wanted_fn(rel)}
    contents = cat_blobs(sorted(set(wanted.values())))
    for rel, sha in sorted(wanted.items()):
        if sha in contents:
            text = contents[sha].decode("utf-8", errors="replace")
            if text != on_disk.get(rel):
                yield f"{rel} (staged)", text


