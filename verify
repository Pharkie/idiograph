def git_env(extra: dict[str, str] | None = None) -> dict[str, str]:
    # No optional locks: a read must never take index.lock from under the other session.
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0")
    if extra:
        env.update(extra)
    return env


def git_run(*args: str, env: dict[str, str] | None = None, cwd: Path | None = None,
            stdin: bytes | None = None) -> tuple[int, bytes, str]:
    proc = subprocess.run(["git", *args], cwd=cwd or ROOT, input=stdin, capture_output=True,
                          env=git_env(env), check=False)
    return proc.returncode, proc.stdout, proc.stderr.decode("utf-8", "replace")


def git(*args: str, env: dict[str, str] | None = None) -> str:
    return git_run(*args, env=env)[1].decode("utf-8", "replace")


def git_z(*args: str, env: dict[str, str] | None = None) -> list[str]:
    """A NUL-separated listing, so a path with an accent arrives unquoted."""
    out = git_run(*args, env=env)[1].decode("utf-8", "surrogateescape")
    return [p for p in out.split("\0") if p]


def head_sha() -> str:
    return git("rev-parse", "--short", "HEAD").strip() or "unknown"


def tree_state(env: dict[str, str] | None = None) -> str:
    return "clean" if not git_z("status", "--porcelain", "-z", env=env) else "dirty"


def is_text(rel: str) -> bool:
    path = Path(rel)
    return path.suffix.lower() in TEXT_SUFFIXES or path.name == ".gitignore"


def checks_read(rel: str) -> bool:
    """Whether some check reads this file, so it must reach the snapshot as a file."""
    return is_text(rel) or rel in CODE_FILES or rel.startswith(CODE_PREFIXES)


def is_code(rel: str) -> bool:
    return Path(rel).suffix.lower() in CODE_SUFFIXES or rel in CODE_FILES or rel.startswith(CODE_PREFIXES)


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # alive, owned by another user
    return True


# iCloud's copy of a file or folder: the name, a space, a number from 2, then the extension
ICLOUD_COPY_RX = re.compile(r"^(?P<stem>.+) (?:[2-9]|[1-9]\d+)(?P<ext>\.[^. ]+)?$")
ICLOUD_DIR = VERIFY_DIR / "icloud-copies"


def icloud_original(rel: str) -> str | None:
    """The file an untracked path is iCloud's copy of, or None. A part of the path is a copy only
    when the name without its number stands beside it, so a "Chapter 2.docx" with no
    "Chapter.docx" is a file in its own right."""
    parts = rel.split("/")
    for i, part in enumerate(parts):
        m = ICLOUD_COPY_RX.match(part)
        if not m:
            continue
        name = m.group("stem") + (m.group("ext") or "")
        if (ROOT.joinpath(*parts[:i]) / name).exists():
            return "/".join([*parts[:i], name, *parts[i + 1:]])
    return None


def blob(spec: str) -> str | None:
    code, out, _ = git_run("rev-parse", "--verify", "-q", spec)
    return out.decode().strip() or None


def sweep_icloud_copies() -> list[str]:
    """Move iCloud's copies that match their file at HEAD, in the index or on disk into
    .verify/icloud-copies/, and name the ones that differ, which are left in place."""
    lines: list[str] = []
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    for rel in git_z("ls-files", "-z", "--others", "--exclude-standard"):
        orig = icloud_original(rel)
        if not orig:
            continue
        copy = git("hash-object", "--", rel).strip()
        same = {blob(f"HEAD:{orig}"), blob(f":{orig}")}
        if (ROOT / orig).is_file():
            same.add(git("hash-object", "--", orig).strip())
        if copy and copy in same:
            dest = ICLOUD_DIR / stamp / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            os.replace(ROOT / rel, dest)
            lines.append(f"[icloud] moved a copy of {orig} that matched it")
            parent = (ROOT / rel).parent
            while parent != ROOT and parent.is_dir() and not any(parent.iterdir()):
                parent.rmdir()
                parent = parent.parent
        else:
            lines.append(f"[icloud] left a copy of {orig} that differs from it, check it: {rel}")
    return lines


def run(cmd: list[str], cwd: Path | None = None,
        env: dict[str, str] | None = None) -> tuple[int, str]:
    full_env = dict(os.environ)
    if env:
        full_env.update(env)
    proc = subprocess.run(
        cmd, cwd=cwd or ROOT, capture_output=True, text=True, check=False, env=full_env
    )
    return proc.returncode, (proc.stdout + proc.stderr)


class Lock:
    """Machine-wide lock: a directory with the owning PID inside it.

    The directory is built under a private name with its PID file already written,
    then renamed into place, so no other process ever sees a lock without a PID.
    A lock whose PID is dead is stale and is cleared.
    """

    def __init__(self, path: Path) -> None:
        self.path = path

    def acquire(self) -> bool:
        for _ in range(3):
            if self._create():
                return True
            if not self._clear_if_stale():
                return False
        return False

    def wait(self, seconds: float, what: str) -> bool:
        """Acquire, waiting up to `seconds` with one line saying what it waits for."""
        deadline = time.time() + seconds
        noted = False
        while True:
            if self.acquire():
                return True
            if time.time() >= deadline:
                return False
            if not noted:
                print(f"[lock] waiting up to {seconds:.0f}s for the commit lock, held by PID "
                      f"{self.holder()} ({what})", flush=True)
                noted = True
            time.sleep(0.25)

    def holder(self) -> str:
        pid = self._pid_in(self.path)
        return str(pid) if pid is not None else "unknown"

    def release(self) -> None:
        if self._pid_in(self.path) == os.getpid():
            self._remove(self.path)

    @staticmethod
    def _pid_in(path: Path) -> int | None:
        try:
            return int((path / "pid").read_text().strip())
        except (OSError, ValueError):
            return None

    def _create(self) -> bool:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = Path(tempfile.mkdtemp(prefix=f".{self.path.name}.", dir=self.path.parent))
        (tmp / "pid").write_text(f"{os.getpid()}\n")
        try:
            os.rename(tmp, self.path)
            return True
        except OSError:
            self._remove(tmp)
            return False

    def _clear_if_stale(self) -> bool:
        """Clear a lock whose owner is dead. True when the lock is gone, False while it is held."""
        pid = self._pid_in(self.path)
        if pid is not None and pid != os.getpid() and pid_alive(pid):
            return False
        tomb = self.path.with_name(f".{self.path.name}.stale.{os.getpid()}.{time.time_ns()}")
        try:
            os.rename(self.path, tomb)
        except FileNotFoundError:
            return True
        except OSError:
            return False
        if self._pid_in(tomb) != pid:
            # A new owner took it between the read and the rename: hand it back.
            try:
                os.rename(tomb, self.path)
            except OSError:
                pass
            return False
        self._remove(tomb)
        return True

    @staticmethod
    def _remove(path: Path) -> None:
        try:
            (path / "pid").unlink(missing_ok=True)
            path.rmdir()
        except OSError:
            shutil.rmtree(path, ignore_errors=True)


def remove_tree(base: Path, links: list[Path] | None = None) -> bool:
    """Remove a snapshot or commit folder. Links into the real tree go first, and rmtree
    never follows a link, so nothing outside the folder is touched."""
    for link in links or []:
        try:
            if link.is_symlink():
                link.unlink()
        except OSError:
            pass

    def retry(func, path, _exc):
        try:
            os.chmod(os.path.dirname(path), 0o700)
            func(path)
        except OSError:
            pass

    if base.is_symlink():
        base.unlink()
    elif base.exists():
        if sys.version_info >= (3, 12):
            shutil.rmtree(base, onexc=retry)
        else:
            shutil.rmtree(base, onerror=retry)
    return not os.path.lexists(base)


def sweep_stale_work() -> None:
    """Remove a snapshot or commit folder left by a run that died before its cleanup."""
    for prefix in (SNAP_PREFIX, COMMIT_PREFIX):
        for path in TMP.glob(prefix + "*"):
            match = re.fullmatch(re.escape(prefix) + r"(\d+)", path.name)
            if match and path.is_dir() and not path.is_symlink() and not pid_alive(int(match.group(1))):
                remove_tree(path)


