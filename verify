def env_seconds(name: str, default: float) -> float:
    value = os.environ.get(name, "").strip()
    try:
        return max(0.0, float(value)) if value else default
    except ValueError:
        return default


def heavy_queues() -> list[Path]:
    """The other queue folders heavy reads (Harbour's, until its harness writes waiting/ files),
    taken from heavy itself so the two never drift. Its line reads QUEUES="<folders>" or, since
    17 October, QUEUES="${HEAVY_QUEUES-<folders>}", where a HEAVY_QUEUES in the environment wins."""
    try:
        match = re.search(r'^QUEUES="(\$\{HEAVY_QUEUES-)?([^"}]*)\}?"',
                          HEAVY.read_text(encoding="utf-8"), re.M)
    except OSError:
        return []
    if not match:
        return []
    folders = match.group(2)
    if match.group(1) and "HEAVY_QUEUES" in os.environ:
        folders = os.environ["HEAVY_QUEUES"]
    return [Path(p) for p in folders.split()]


